{
  "expo": {
    "name": "Salah Circle",
    "slug": "sallahcircle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sallahcircle",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.mufy007.salahcircle",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141A3E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mufy007.salahcircle"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141A3E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Salah Circle uses your location to calculate accurate prayer times and the Qibla direction."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/chime.wav"
          ],
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#8FE3C0"
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Salah Circle uses the microphone so you can send short voice nudges to your circle."
        }
      ],
      "expo-asset",
      "expo-sharing",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "NextPrayer",
              "displayName": "Next prayer",
              "description": "Countdown to the next prayer.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d3c3863f-a780-4730-ad15-94e0e027adb6"
      }
    },
    "owner": "mufy007"
  }
}
